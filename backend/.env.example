# Copy to backend/.env and adjust. NEVER commit the real .env.
APP_NAME=Meridia API
ENVIRONMENT=development
DEBUG=true

# Local Docker PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://meridia:devpass@localhost:5432/meridia

# Auth — generate a strong secret for every deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS origins (comma-separated JSON list). "*" is fine for local dev only.
CORS_ORIGINS=["*"]
